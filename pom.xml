<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>xyz.zcraft.studios</groupId>
    <artifactId>z-ffa-core</artifactId>
    <version>1.4.0</version>
    <packaging>jar</packaging>

    <properties>
        <java.version>17</java.version>
        <mc.version>1.20</mc.version>
        <bukkit.api.version>1.20</bukkit.api.version>
        <paper.version>1.20.6-R0.1-SNAPSHOT</paper.version>
        <velocity.version>3.3.0-SNAPSHOT</velocity.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- ================= REPOSITORIES ================= -->
    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>

        <repository>
            <id>spigotmc-snapshots</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>

        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>

        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>

    </repositories>

    <!-- ================= DEPENDENCIES ================= -->
    <dependencies>

        <!-- Paper API -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- PlaceholderAPI -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>

        <!-- Vault API (FIXED ERROR) -->
        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7</version>
            <scope>provided</scope>
        </dependency>

        <!-- Bungee/Waterfall proxy coordinator entrypoint, packaged in the same jar -->
        <dependency>
            <groupId>net.md-5</groupId>
            <artifactId>bungeecord-api</artifactId>
            <version>1.20-R0.2</version>
            <scope>provided</scope>
        </dependency>

        <!-- Velocity proxy coordinator entrypoint, packaged in the same jar -->
        <dependency>
            <groupId>com.velocitypowered</groupId>
            <artifactId>velocity-api</artifactId>
            <version>${velocity.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Database / libs -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>6.3.0</version>
        </dependency>

        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>3.2.0</version>
        </dependency>

        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.49.1.0</version>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>9.2.0</version>
        </dependency>

        <!-- bStats Metrics -->
        <dependency>
            <groupId>org.bstats</groupId>
            <artifactId>bstats-bukkit</artifactId>
            <version>3.0.2</version>
            <scope>compile</scope>
        </dependency>

    </dependencies>

    <!-- ================= BUILD ================= -->
    <build>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>

        <plugins>

            <!-- Compiler -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <release>${java.version}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.velocitypowered</groupId>
                            <artifactId>velocity-api</artifactId>
                            <version>${velocity.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Slim proxy coordinator jars. Keep one project version, attach one jar per platform. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <executions>
                    <execution>
                        <id>bungee-plugin</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>mc-${mc.version}-proxy-bungee</classifier>
                            <includes>
                                <include>xyz/zcraft/studios/zffa/proxy/bungee/**</include>
                                <include>bungee.yml</include>
                            </includes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>velocity-plugin</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>mc-${mc.version}-proxy-velocity</classifier>
                            <includes>
                                <include>xyz/zcraft/studios/zffa/proxy/velocity/**</include>
                                <include>velocity-plugin.json</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Shade (creates final plugin jar) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>bukkit-plugin</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>

                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>mc-${mc.version}-backend-full</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/maven/**</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>${project.groupId}:${project.artifactId}</artifact>
                                    <excludes>
                                        <exclude>xyz/zcraft/studios/zffa/proxy/bungee/**</exclude>
                                        <exclude>xyz/zcraft/studios/zffa/proxy/velocity/**</exclude>
                                        <exclude>bungee.yml</exclude>
                                        <exclude>velocity-plugin.json</exclude>
                                    </excludes>
                                </filter>
                            </filters>

                            <relocations>
                                <relocation>
                                    <pattern>com.zaxxer.hikari</pattern>
                                    <shadedPattern>xyz.zcraft.studios.zffa.libs.hikari</shadedPattern>
                                </relocation>

                                <relocation>
                                    <pattern>com.github.benmanes.caffeine</pattern>
                                    <shadedPattern>xyz.zcraft.studios.zffa.libs.caffeine</shadedPattern>
                                </relocation>

                                <relocation>
                                    <pattern>org.bstats</pattern>
                                    <shadedPattern>xyz.zcraft.studios.zffa.libs.bstats</shadedPattern>
                                </relocation>
                            </relocations>

                        </configuration>
                    </execution>
                    <execution>
                        <id>split-backend-plugin</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>

                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>mc-${mc.version}-backend-split</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/maven/**</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>${project.groupId}:${project.artifactId}</artifact>
                                    <excludes>
                                        <exclude>xyz/zcraft/studios/zffa/proxy/bungee/**</exclude>
                                        <exclude>xyz/zcraft/studios/zffa/proxy/velocity/**</exclude>
                                        <exclude>bungee.yml</exclude>
                                        <exclude>velocity-plugin.json</exclude>
                                    </excludes>
                                </filter>
                            </filters>

                            <relocations>
                                <relocation>
                                    <pattern>com.zaxxer.hikari</pattern>
                                    <shadedPattern>xyz.zcraft.studios.zffa.libs.hikari</shadedPattern>
                                </relocation>

                                <relocation>
                                    <pattern>com.github.benmanes.caffeine</pattern>
                                    <shadedPattern>xyz.zcraft.studios.zffa.libs.caffeine</shadedPattern>
                                </relocation>

                                <relocation>
                                    <pattern>org.bstats</pattern>
                                    <shadedPattern>xyz.zcraft.studios.zffa.libs.bstats</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Fork-labeled backend jars for release bundles. These jars share the same backend bytecode;
                 labels make install targets clear for server owners. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>copy-fork-labeled-backends</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <copy file="${project.build.directory}/${project.artifactId}-${project.version}-mc-${mc.version}-backend-full.jar"
                                      tofile="${project.build.directory}/${project.artifactId}-${project.version}-mc-${mc.version}-backend-full-spigot.jar" />
                                <copy file="${project.build.directory}/${project.artifactId}-${project.version}-mc-${mc.version}-backend-full.jar"
                                      tofile="${project.build.directory}/${project.artifactId}-${project.version}-mc-${mc.version}-backend-full-paper.jar" />
                                <copy file="${project.build.directory}/${project.artifactId}-${project.version}-mc-${mc.version}-backend-full.jar"
                                      tofile="${project.build.directory}/${project.artifactId}-${project.version}-mc-${mc.version}-backend-full-purpur.jar" />
                                <copy file="${project.build.directory}/${project.artifactId}-${project.version}-mc-${mc.version}-backend-full.jar"
                                      tofile="${project.build.directory}/${project.artifactId}-${project.version}-mc-${mc.version}-backend-full-folia.jar" />

                                <copy file="${project.build.directory}/${project.artifactId}-${project.version}-mc-${mc.version}-backend-split.jar"
                                      tofile="${project.build.directory}/${project.artifactId}-${project.version}-mc-${mc.version}-backend-split-spigot.jar" />
                                <copy file="${project.build.directory}/${project.artifactId}-${project.version}-mc-${mc.version}-backend-split.jar"
                                      tofile="${project.build.directory}/${project.artifactId}-${project.version}-mc-${mc.version}-backend-split-paper.jar" />
                                <copy file="${project.build.directory}/${project.artifactId}-${project.version}-mc-${mc.version}-backend-split.jar"
                                      tofile="${project.build.directory}/${project.artifactId}-${project.version}-mc-${mc.version}-backend-split-purpur.jar" />
                                <copy file="${project.build.directory}/${project.artifactId}-${project.version}-mc-${mc.version}-backend-split.jar"
                                      tofile="${project.build.directory}/${project.artifactId}-${project.version}-mc-${mc.version}-backend-split-folia.jar" />
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <profiles>
        <profile>
            <id>mc120</id>
            <properties>
                <mc.version>1.20</mc.version>
                <bukkit.api.version>1.20</bukkit.api.version>
                <paper.version>1.20.6-R0.1-SNAPSHOT</paper.version>
            </properties>
        </profile>

        <profile>
            <id>mc121</id>
            <properties>
                <mc.version>1.21</mc.version>
                <bukkit.api.version>1.21</bukkit.api.version>
                <paper.version>1.21.11-R0.1-SNAPSHOT</paper.version>
            </properties>
        </profile>

        <profile>
            <id>mc261</id>
            <properties>
                <mc.version>26.1</mc.version>
                <bukkit.api.version>1.21</bukkit.api.version>
                <paper.version>26.1.2.build.66-stable</paper.version>
            </properties>
        </profile>
    </profiles>

</project>
